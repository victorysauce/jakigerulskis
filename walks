<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Photowalks — Jaki Gerulskis</title>
<meta name="description" content="Join a photowalk with Jaki Gerulskis in Lisbon. Street photography, infrared, and seeing the city differently.">
<!-- Keep this page out of search indexes -->
<meta name="robots" content="noindex, nofollow">

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;700&family=DM+Sans:ital,wght@0,400;0,500;1,400&family=Source+Serif+4:ital@1&display=swap" rel="stylesheet">

<style>
  :root {
    --blue:  #2448C8;
    --teal:  #0EC4B0;
    --pink:  #E8396A;
    --cream: #F2EDE3;
    --black: #0D0D0D;
    --oswald: 'Oswald', sans-serif;
    --dm:    'DM Sans', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--black);
    color: var(--cream);
    font-family: var(--dm);
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* Noise overlay — matches main site */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
    opacity: 0.35;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    background: rgba(13,13,13,0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .nav-logo {
    font-family: var(--oswald);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.08em;
    color: var(--cream);
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav-logo span { color: var(--pink); }

  .nav-back {
    font-family: var(--oswald);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(242,237,227,0.55);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-back:hover { color: var(--teal); }

  /* ── MAIN LAYOUT ── */
  main {
    padding-top: 72px;
    min-height: 100vh;
  }

  /* ── HERO ── */
  .hero {
    padding: 64px 40px 48px;
    border-left: 4px solid var(--teal);
    margin: 40px 40px 0;
    max-width: 720px;
  }

  .hero-label {
    font-family: var(--oswald);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--teal);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .hero h1 {
    font-family: var(--oswald);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 72px);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.92;
    color: var(--cream);
    margin-bottom: 24px;
  }

  .hero p {
    font-size: 16px;
    color: rgba(242,237,227,0.7);
    line-height: 1.75;
    max-width: 560px;
  }

  /* ── CONTENT GRID ── */
  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin: 48px 40px 0;
  }

  /* ── WHAT TO EXPECT ── */
  .expect-block {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    padding: 40px;
  }

  .block-label {
    font-family: var(--oswald);
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--pink);
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .expect-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .expect-list li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 14px;
    align-items: start;
  }

  .expect-list li::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background: var(--teal);
    margin-top: 8px;
    justify-self: center;
    flex-shrink: 0;
  }

  .expect-list li span {
    font-size: 15px;
    color: rgba(242,237,227,0.75);
    line-height: 1.6;
  }

  .expect-list li strong {
    display: block;
    font-family: var(--oswald);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cream);
    margin-bottom: 4px;
    font-weight: 400;
  }

  /* ── REVIEW BLOCK ── */
  .review-block {
    background: rgba(36,72,200,0.1);
    border: 1px solid rgba(36,72,200,0.25);
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .review-block .block-label {
    color: var(--teal);
    margin-bottom: 0;
  }

  .review-intro {
    font-size: 15px;
    color: rgba(242,237,227,0.65);
    line-height: 1.75;
  }

  /* TripAdvisor widget container */
  .ta-widget-wrap {
    width: 100%;
  }

  /* ── QUOTE ── */
  .quote-strip {
    margin: 2px 40px 0;
    background: var(--blue);
    padding: 40px;
    position: relative;
    overflow: hidden;
  }

  .quote-strip::before {
    content: '"';
    position: absolute;
    top: -20px;
    left: 24px;
    font-family: var(--oswald);
    font-size: 160px;
    font-weight: 700;
    color: rgba(255,255,255,0.07);
    line-height: 1;
    pointer-events: none;
  }

  .quote-text {
    font-family: 'Source Serif 4', serif;
    font-style: italic;
    font-size: clamp(18px, 2.5vw, 26px);
    line-height: 1.55;
    color: var(--cream);
    max-width: 640px;
    position: relative;
  }

  .quote-attr {
    margin-top: 20px;
    font-family: var(--oswald);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(242,237,227,0.5);
  }

  /* ── BOOKING TEASER ── */
  .booking-strip {
    margin: 2px 40px 0;
    background: rgba(14,196,176,0.08);
    border: 1px solid rgba(14,196,176,0.2);
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .booking-strip h3 {
    font-family: var(--oswald);
    font-weight: 700;
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--cream);
    margin-bottom: 8px;
  }

  .booking-strip p {
    font-size: 14px;
    color: rgba(242,237,227,0.6);
    max-width: 440px;
    line-height: 1.65;
  }

  .btn {
    font-family: var(--oswald);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 14px 32px;
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .btn-primary {
    background: var(--teal);
    color: var(--black);
  }
  .btn-primary:hover { background: var(--blue); color: var(--cream); }

  /* ── FOOTER ── */
  footer {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 80px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-logo {
    font-family: var(--oswald);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(242,237,227,0.6);
  }
  .footer-logo span { color: var(--pink); opacity: 0.8; }

  .footer-copy {
    font-size: 12px;
    color: rgba(242,237,227,0.4);
    letter-spacing: 0.04em;
  }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--black); }
  ::-webkit-scrollbar-thumb { background: var(--blue); }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    nav { padding: 16px 20px; }

    .hero {
      margin: 24px 20px 0;
      padding: 32px 24px;
    }

    .content {
      grid-template-columns: 1fr;
      margin: 32px 20px 0;
    }

    .quote-strip {
      margin: 2px 20px 0;
      padding: 32px 24px;
    }

    .booking-strip {
      margin: 2px 20px 0;
      padding: 32px 24px;
      flex-direction: column;
      align-items: flex-start;
    }

    footer { padding: 32px 20px; }
  }
</style>
</head>
